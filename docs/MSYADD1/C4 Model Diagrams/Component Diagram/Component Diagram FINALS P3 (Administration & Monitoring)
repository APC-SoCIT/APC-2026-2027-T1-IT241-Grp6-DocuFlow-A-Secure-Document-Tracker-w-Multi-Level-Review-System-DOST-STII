@startuml Component_Diagram_Admin_Monitoring

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
skinparam nodesep 40
skinparam ranksep 70

title Component Diagram - DocuFlow Backend (Administration & Monitoring)

Container(frontend, "Web Application", "React", "Sends admin configuration requests and queries audit logs.")

Container_Boundary(backendBoundary, "DocuFlow Backend Application (Laravel / Apache)") {

    Component(authMiddleware, "Auth & Access Middleware", "Laravel Middleware", "Enforces session auth, RBAC global roles, ABAC document assignment, and the self-review restriction.")
    Component(tatScheduler, "TAT Cron Scheduler", "Laravel Task Scheduler", "Runs daily automated checks for overdue reviews and triggers TAT reminders.")

    Component(adminController, "System Admin Controller", "Laravel Controller", "Handles UC-04 (Manage System Administration): Manages users, reviewer eligibility, holiday calendar, and AI configuration.")
    Component(auditController, "Audit Trail Controller", "Laravel Controller", "Handles UC-05 (View Audit Trail): Queries immutable audit logs and generates CSV exports.")
    Component(overdueMonitorService, "Overdue Monitoring Service", "Laravel Service", "Evaluates pending reviews against the holiday calendar and the five-working-day review period to detect documents that have become overdue.")
    Component(notificationService, "Notification Service", "Laravel Service", "Creates in-system notification records and prepares workflow, review, and overdue reminder emails for delivery.")

    Component(aiKnowledgeService, "AI Knowledge Service", "Laravel Service", "Records Accept/Modify/Disregard/Flag actions on AI suggestions, creates Pending AI Knowledge from remarks marked by reviewers, and supplies Active AI Knowledge to the AI client.")
    Component(auditService, "Audit Logging Service", "Laravel Service", "Writes immutable, server-timestamped activity records for document, review, administrative, and integration events.")
}

ContainerDb(database, "DocuFlow Database", "MySQL", "Stores user accounts, reviewer eligibility, holidays, AI knowledge, audit logs, and in-system notifications.")
System_Ext(emailService, "Email", "SMTP mail server delivering automated workflow and overdue notifications.")


Lay_R(authMiddleware, tatScheduler)
Lay_R(adminController, auditController)
Lay_R(auditController, notificationService)
Lay_R(notificationService, overdueMonitorService)
Lay_R(aiKnowledgeService, auditService)

Rel_D(frontend, authMiddleware, "Sends Admin/Audit requests", "HTTPS / JSON")

Rel_D(authMiddleware, adminController, "Routes Super Admin requests", "Internal")
Rel_D(authMiddleware, auditController, "Routes Super Admin requests", "Internal")

Rel_D(tatScheduler, overdueMonitorService, "Checks overdue reviews", "Daily Cron")
Rel_D(tatScheduler, notificationService, "Triggers overdue notifications", "Internal")

Rel_D(adminController, aiKnowledgeService, "Manages AI knowledge", "Internal")
Rel_D(adminController, auditService, "Logs admin changes", "Internal")
Rel_D(notificationService, auditService, "Logs delivery failures", "Internal")

Rel_D(aiKnowledgeService, database, "Reads and writes AI knowledge", "Eloquent ORM")
Rel_D(auditService, database, "Writes audit records", "Eloquent ORM")
Rel_D(adminController, database, "Updates users, eligibility, holidays, AI settings", "Eloquent ORM")
Rel_D(auditController, database, "Reads audit logs", "Eloquent ORM")
Rel_D(overdueMonitorService, database, "Reads pending reviews and holidays", "Eloquent ORM")
Rel_D(notificationService, database, "Writes in-system notifications", "Eloquent ORM")

Rel_D(notificationService, emailService, "Sends overdue reminder emails", "SMTP")

@enduml
