@startuml Container_Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

title Container Diagram - DocuFlow: A Secure Document Tracker with Multi-Level Review System for DOST-STII


Person(docSource, "Document Source", "DOST-STII staff member who creates submissions, tracks status, and resubmits returned documents.")

Person(l1Reviewer, "Immediate Supervisor (L1)", "Performs first-level review (return or forward) and submits documents.")

Person(l2Reviewer, "Section Head (L2)", "Performs second-level review (return or endorse) and submits documents.")

Person(l3Reviewer, "Division Chief (L3)", "Performs final review and approves or returns documents.")

Person(superAdmin, "Super Admin", "Manages user accounts, reviewer eligibility, holiday calendar, AI knowledge, and views audit trail.")


System_Boundary(docuflowBoundary, "DocuFlow") {

    Container(frontend, "Web Application", "React", "Provides role-based dashboards, document submission forms, review interfaces, in-system notifications, audit views, and administration screens.")

    Container(backend, "Backend Application", "Laravel / PHP (Apache)", "Handles authentication and access rules, document workflow routing, reviewer assignment, submissions and resubmissions, reference numbers, review actions, in-system notifications, audit logging, turnaround-time monitoring with a daily scheduled overdue check (Laravel scheduler), reporting, Google Workspace integration, and AI Assistant integration.")

    ContainerDb(database, "DocuFlow Database", "MySQL", "Stores user accounts, roles, document records, uploaded file locations, reviewer assignments, revision history, remarks, activity logs, AI results, notifications, holiday calendar data, and other system records.")

    ContainerDb(fileStorage, "Uploaded File Storage", "Laravel local file storage", "Stores uploaded .pdf, .docx, and .xlsx files (up to 10MB per file). The files are kept outside the database, which only stores their locations.")
}


System_Ext(emailService, "Email", "Delivers automated workflow and overdue notification emails.")

System_Ext(aiAssistant, "AI Assistant", "Locally hosted language model (Ollama) that provides preliminary document feedback and possible duplicate-submission detection.")

System_Ext(googleWorkspace, "Google Workspace", "Hosts live Google Workspace documents and provides document access and edit events through Google Workspace integration.")


Lay_R(docSource, l1Reviewer)
Lay_R(l1Reviewer, l2Reviewer)
Lay_R(l2Reviewer, l3Reviewer)
Lay_R(l3Reviewer, superAdmin)

Lay_D(frontend, backend)
Lay_R(backend, database)
Lay_D(database, fileStorage)

Lay_R(emailService, aiAssistant)
Lay_R(aiAssistant, googleWorkspace)


Rel(docSource, frontend, "Manages documents, submits/resubmits documents, views in-system notifications", "HTTPS / Web Browser")

Rel(l1Reviewer, frontend, "Manages documents, submits/resubmits, performs L1 reviews, views in-system notifications", "HTTPS / Web Browser")

Rel(l2Reviewer, frontend, "Manages documents, submits/resubmits, performs L2 reviews, views in-system notifications", "HTTPS / Web Browser")

Rel(l3Reviewer, frontend, "Manages documents, performs L3 reviews and approvals, views in-system notifications", "HTTPS / Web Browser")

Rel(superAdmin, frontend, "Manages documents, system administration, reviewer eligibility, and audit trail", "HTTPS / Web Browser")


Rel_D(frontend, backend, "Sends user requests and receives system data", "HTTPS")

Rel_R(backend, database, "Reads and writes system records and in-system notifications", "MySQL")

Rel_D(backend, fileStorage, "Saves uploaded files and retrieves them for reviewers", "Laravel Filesystem")


Rel_D(backend, emailService, "Sends workflow and overdue\nnotification emails", "SMTP")

Rel_D(backend, aiAssistant, "Sends document content and metadata;\nreceives preliminary feedback and duplicate-check results", "HTTP / REST API")

Rel_D(backend, googleWorkspace, "Accesses live document information and receives document edit events", "Google Workspace APIs / Webhooks")

@enduml
